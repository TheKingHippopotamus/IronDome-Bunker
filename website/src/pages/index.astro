    background: var(--steel);
  }
  .term-cap { margin: 0; font-size: 12.5px; color: var(--fg-3); }
  .term-ctl { display: flex; gap: 8px; }
  .ctl {
    background: none;
    border: 1px solid var(--rule-hi);
    color: var(--fg-3);
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    padding: 6px 11px;
    cursor: pointer;
    transition: color .2s, border-color .2s;
  }
  .ctl:hover { color: var(--dome); border-color: var(--dome-dim); }

  /* ── screen gallery ── */
  .shots { margin-top: 56px; }
  .shots-head {
    font-size: 10.5px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--fg-4);
    margin: 0 0 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
  }
  .shots-grid { display: grid; gap: 16px; }
  @media (min-width: 700px)  { .shots-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .shots-grid { grid-template-columns: repeat(3, 1fr); } }
  .shot { margin: 0; }
  .shot-img {
    border: 1px solid var(--rule);
    background: #080c0d;
    overflow: hidden;
    transition: border-color .3s var(--ease), transform .3s var(--ease);
  }
  .shot-img img { width: 100%; height: auto; display: block; }
  .shot:hover .shot-img { border-color: var(--dome-dim); transform: translateY(-3px); }
  .shot figcaption { padding: 12px 2px 0; display: flex; flex-direction: column; gap: 3px; }
  .shot-n { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--fg); }
  .shot-b { font-size: 12.5px; color: var(--fg-4); }

  /* ══════════════════════════════ SPEC ══════════════════════════════ */
  .spec { margin-top: 40px; border-top: 1px solid var(--rule); }
  .spec dl { margin: 0; }
  .spec-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px 24px;
    padding: 14px 2px;
    border-bottom: 1px solid var(--rule);
    transition: background .25s var(--ease);
  }
  .spec-row:hover { background: var(--panel); }
  .spec dt { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--fg-4); }
  .spec dd { margin: 0; font-size: 13.5px; color: var(--fg); }
  @media (min-width: 720px) { .spec-row { grid-template-columns: 300px 1fr; align-items: baseline; } }

  /* ══════════════════════════════ LIMITS ══════════════════════════════ */
  .sector--limits { background: #0a0c08; }
  .eyebrow--warn { color: var(--amber); }
  .limits { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 0; }
  .limit {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 22px 0;
    border-top: 1px solid var(--rule);
  }
  .limit:last-child { border-bottom: 1px solid var(--rule); }
  .limit .badge { align-self: start; justify-self: start; }
  .limit h3 { font-size: 15.5px; margin: 0 0 8px; color: var(--fg); }
  .limit p { margin: 0; font-size: 14px; color: var(--fg-3); max-width: 72ch; }
  @media (min-width: 720px) { .limit { grid-template-columns: 96px 1fr; gap: 24px; } }

  /* ══════════════════════════════ CTA ══════════════════════════════ */
  .cta {
    background:
      radial-gradient(ellipse 80% 100% at 50% 100%, rgba(155, 174, 74, .10), transparent 62%),
      var(--void);
  }
  .cta-in { text-align: left; }
  .cta-h2 { font-size: clamp(30px, 4.6vw, 56px); }
  .install { margin-top: 38px; padding: 26px 24px; display: grid; gap: 14px; }
  .install-row { display: grid; grid-template-columns: 1fr; gap: 8px; align-items: center; }
  .install-k { font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--fg-4); }
  .install-foot { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
  @media (min-width: 720px) { .install-row { grid-template-columns: 110px 1fr; gap: 18px; } }

  /* --- corrections pass 1 --- */
  .hero { padding-block: clamp(56px, 7.5vw, 104px) clamp(56px, 7vw, 96px); }
  .hero-scope {
    top: 50%; right: -2%;
    transform: translateY(-48%);
    width: min(46vw, 600px);
    --scope-op: .40;
    opacity: var(--scope-op);
  }
  .hero-scope img { width: 100%; height: auto; }
  @media (max-width: 900px) {
    .hero-scope { top: -2%; right: -34%; transform: none; width: 108vw; --scope-op: .07; opacity: var(--scope-op); }
  }
  @media (max-width: 480px) {
    .hero-eye { font-size: 10px; letter-spacing: .16em; padding: 6px 10px; }
  }
  .hero-h1 {
    font-size: clamp(30px, 4.9vw, 60px);
    line-height: 1.07;
    letter-spacing: -.038em;
    max-width: 22ch;
  }
  .hero-h1 .ln { display: block; overflow: visible; }
  .cards > * { min-width: 0; }
  .card { min-width: 0; overflow: hidden; }
  .card-code { max-width: 100%; }
  .layers, .layer, .sector-inner { min-width: 0; }
</style>

<script define:vars={{ scenes }}>
  /* ── shared: reveal on scroll ─────────────────────────────────── */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const revealIO = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) { e.target.classList.add('is-in'); revealIO.unobserve(e.target); }
    }
  }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
  document.querySelectorAll('.reveal').forEach((el) => revealIO.observe(el));

  /* ── copy buttons ─────────────────────────────────────────────── */
  document.querySelectorAll('.copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || '');
        const prev = btn.textContent;
        btn.textContent = 'Copied';
        btn.dataset.done = '1';
        setTimeout(() => { btn.textContent = prev; delete btn.dataset.done; }, 1600);
      } catch { btn.textContent = 'Select it'; }
    });
  });

  /* ── dome: arc lengths, arm on view, focus from the legend ────── */
  const svg = document.getElementById('dome-svg');
  if (svg) {
    svg.querySelectorAll('.d-arc').forEach((p) => {
      p.style.setProperty('--len', Math.ceil(p.getTotalLength()) + 'px');
    });
    new IntersectionObserver((entries, o) => {
      for (const e of entries) {
        if (e.isIntersecting) { svg.classList.add('is-armed'); o.disconnect(); }
      }
    }, { threshold: 0.2 }).observe(svg);

    document.querySelectorAll('[data-ring-hover]').forEach((el) => {
      const on = () => svg.setAttribute('data-focus', el.dataset.ringHover);
      const off = () => svg.removeAttribute('data-focus');
      el.addEventListener('mouseenter', on);
      el.addEventListener('focus', on);
      el.addEventListener('mouseleave', off);
      el.addEventListener('blur', off);
    });
  }

  /* ── terminal player ──────────────────────────────────────────── */
  const out = document.getElementById('term-out');
  const cap = document.getElementById('term-cap');
  const toggle = document.getElementById('term-toggle');
  const restart = document.getElementById('term-restart');
  const tabs = [...document.querySelectorAll('.tab')];

  if (out && scenes.length) {
    const esc = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const cls = (line) => {
      const t = line.trim();
      if (/^(✅|\[OK\])/.test(t)) return 'l-ok';
      if (/^(⚠️|⛔)/.test(t)) return 'l-warn';
      if (/^(❌|\[!!\])/.test(t)) return 'l-bad';
      if (/^===/.test(t) || /^  [A-Za-z].*:/.test(line)) return 'l-head';
      if (/^[\s]*[█╗╔╚╝║═╠╣╬─│┌┐└┘]/.test(line)) return 'l-art';
      return '';
    };

    let scene = 0, timer = null, paused = false, playing = false;
    const sleep = (ms) => new Promise((r) => { timer = setTimeout(r, ms); });
    const gate = async () => { while (paused) await sleep(120); };
    let token = 0;

    function setTabs(i) {
      tabs.forEach((t, k) => t.setAttribute('aria-selected', k === i ? 'true' : 'false'));
      cap.textContent = scenes[i].caption;
    }

    function append(html) {
      const caret = out.querySelector('.caret');
      if (caret) caret.remove();
      const tpl = document.createElement('template');
      tpl.innerHTML = html;
      const nodes = [...tpl.content.childNodes];
      out.append(...nodes);
      out.insertAdjacentHTML('beforeend', '<span class="caret"></span>');
      out.scrollTop = out.scrollHeight;
      return nodes[0];
    }

    async function play(i) {
      const my = ++token;
      clearTimeout(timer);
      scene = i;
      setTabs(i);
      out.replaceChildren();
      out.insertAdjacentHTML('beforeend', '<span class="caret"></span>');
      playing = true;

      if (reduce) {
        let html = '';
        for (const b of scenes[i].blocks) {
          html += '<span class="l-cmd"><span class="p">$</span> ' + esc(b.cmd) + '</span>\n';
          for (const l of b.out) html += '<span class="' + cls(l) + '">' + esc(l) + '</span>\n';
          html += '\n';
        }
        out.innerHTML = html;
        playing = false;
        return;
      }

      for (const b of scenes[i].blocks) {
        await gate(); if (my !== token) return;
        const node = append('<span class="l-cmd"><span class="p">$</span> </span>');
        for (const ch of b.cmd) {
          await gate(); if (my !== token) return;
          node.append(document.createTextNode(ch));
          out.scrollTop = out.scrollHeight;
          await sleep(24 + Math.random() * 44 + (ch === ' ' ? 34 : 0));
        }
        await sleep(280);
        append('\n');
        for (const l of b.out) {
          await gate(); if (my !== token) return;
          append('<span class="' + cls(l) + '">' + esc(l) + '</span>\n');
          await sleep(l.trim() === '' ? 36 : 24 + Math.min(l.length, 60) * 1.4);
        }
        append('\n');
        await sleep(560);
      }
      playing = false;
      await sleep(1600);
      if (my !== token || paused) return;
      play((i + 1) % scenes.length);
    }

    tabs.forEach((t, i) => t.addEventListener('click', () => { paused = false; toggle.textContent = 'Pause'; play(i); }));
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.textContent = paused ? 'Resume' : 'Pause';
      toggle.setAttribute('aria-label', paused ? 'Resume playback' : 'Pause playback');
      if (!paused && !playing) play(scene);
    });
    restart.addEventListener('click', () => { paused = false; toggle.textContent = 'Pause'; play(scene); });

    let started = false;
    new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && !started) { started = true; play(0); }
        else if (!e.isIntersecting && started) { paused = true; toggle.textContent = 'Resume'; }
      }
    }, { threshold: 0.25 }).observe(document.getElementById('term'));

    setTabs(0);
    out.insertAdjacentHTML('beforeend', '<span class="caret"></span>');
  }
</script>
