---
import Layout from '../layouts/Layout.astro';
import transcript from '../data/transcript.txt?raw';
/* Written by scripts/counts.py from the suite and the package itself.
   Never edit by hand: the page states numbers, it does not decide them. */
import counts from '../data/counts.json';

const B = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

/* ------------------------------------------------------------------
   The terminal scenes are parsed at build time from a transcript that
   was captured by driving the real 3.2.1 CLI in a throwaway HOME.
   Nothing here is written by hand — the file is the recording.
   ------------------------------------------------------------------ */
type Block = { cmd: string; out: string[] };
const blocks: Block[] = [];
for (const line of transcript.split('\n')) {
  if (line.startsWith('$ ')) blocks.push({ cmd: line.slice(2), out: [] });
  else if (blocks.length) blocks[blocks.length - 1].out.push(line);
}
for (const b of blocks) {
  while (b.out.length && b.out[b.out.length - 1].trim() === '') b.out.pop();
}

const sceneSpec: [string, string, number][] = [
  ['SETUP',   'A vault is created. Nothing exists until you make it.', 3],
  ['UNLOCK',  'One password opens a 30-minute airspace window.',       1],
  ['STORE',   'Four entries generated, encrypted, written.',           4],
  ['RECALL',  'Listing and searching a live vault.',                   4],
  ['SEAL',    'Encrypted backup, status, lock down.',                  3],
  ['LOCKOUT', 'Three wrong passwords, and the device is out.',         4],
  ['NUKE',    'Self-destruct, and an honest count of what went.',      2],
];
let cursor = 0;
const scenes = sceneSpec.map(([name, caption, n]) => {
  const slice = blocks.slice(cursor, cursor + n);
  cursor += n;
  return { name, caption, blocks: slice };
});

/* ------------------------------------------------------------------
   The per-file breakdown printed on the test card, formatted from the
   same collection run that produced the total.
   ------------------------------------------------------------------ */
const testBreakdown = Object.entries(counts.files as Record<string, number>)
  .sort((a, b) => b[1] - a[1])
  .map(([name, n]) => `${name.padEnd(20)}${String(n).padStart(3)}`)
  .join('\n');

/* ------------------------------------------------------------------ */
const facts = [
  [counts.version,        'on PyPI'],
  [String(counts.tests),  'tests, run before publish'],
  ['0',                   'network calls in the package'],
  ['600,000',             'PBKDF2 iterations'],
  [String(counts.screens),'screens in the TUI'],
  ['GPL-3.0',             'source is the spec'],
];

const steps = [
  {
    n: 'Install',
    cmd: 'pip install IronDome',
    body: 'One package, three dependencies: cryptography, keyring, textual. Python 3.8 through 3.13, on macOS, Windows and Linux.',
  },
  {
    n: 'Create the vault',
    cmd: 'irondome-cli create bunker',
    body: 'Pick a security mode, set a master username and password. A 16-byte random salt is written; the password itself never is.',
  },
  {
    n: 'Live in it',
    cmd: 'irondome',
    body: 'The TUI opens. Search, generate, copy, reveal, back up — all keyboard, all local. Ctrl+L locks it again.',
  },
];

const layers = [
  {
    id: 'rest',
    n: '01',
    tag: 'AT REST',
    title: 'The vault on disk',
    sub: 'What survives a reboot, and what it costs to read it.',
    cards: [
      {
        t: 'AES-128-CBC via Fernet',
        b: 'Every entry is encrypted with Fernet, which is AES-128 in CBC mode with an HMAC-SHA256 tag over the ciphertext. Tampering fails loudly instead of decrypting to garbage.',
        badge: 'CIPHER',
        code: 'token = Fernet(key).encrypt(plaintext)\n# 0x80 version | 8B ts | 16B IV | ct | 32B HMAC-SHA256',
      },
      {
        t: 'PBKDF2-HMAC-SHA256 × 600,000',
        b: 'The master password is stretched at the OWASP 2023 minimum before it becomes a key. The iteration count is asserted by a test, so it cannot quietly drop.',
        badge: 'KDF',
        code: 'PBKDF2_ITERATIONS = 600_000\nkdf = PBKDF2HMAC(algorithm=hashes.SHA256(),\n                 length=32, salt=salt,\n                 iterations=PBKDF2_ITERATIONS)',
      },
      {
        t: 'Fresh salt, fresh IV',
        b: 'A 16-byte salt from the OS CSPRNG at setup, and a new 16-byte IV for every single message. Encrypting the same password twice never produces the same bytes.',
        badge: 'ENTROPY',
        code: 'salt = secrets.token_bytes(16)   # once, at setup\n# 8 encryptions of identical plaintext -> 8 distinct IVs',
      },
      {
        t: 'The master password is never written',
        b: 'Only a PBKDF2 digest of it reaches the disk. There is no server to send it to and no file that holds it.',
        badge: 'STORAGE',
        code: '~/.password_manager/secrets/\n  .passwords.enc    .master_hash.enc\n  salt.bin          .master_user.enc',
      },
      {
        t: 'Machine-scoped master record',
        b: 'The stored master-user record is wrapped with a key derived from /etc/machine-id, so a copied folder is not immediately readable. This is obfuscation, not a boundary — machine-id is world-readable and travels with a disk image. The vault itself is protected by your password.',
        badge: 'SCOPE',
        code: 'create_system_key(salt)  # <- /etc/machine-id\n# wraps .master_user.enc + .master_hash.enc only',
      },
      {
        t: 'Encrypted backups on demand',
        b: 'One command writes a timestamped, encrypted copy of the vault beside it. Same key, same cipher, no plaintext export path.',
        badge: 'BACKUP',
        code: '$ bunker fortify\n✅ Dome fortified at: ~/.password_manager/backups/\n   .passwords_backup_20260823-155627.enc',
      },
    ],
  },
  {
    id: 'door',
    n: '02',
    tag: 'AT THE DOOR',
    title: 'Getting in',
    sub: 'Three ways to authenticate, and one way to be locked out.',
    cards: [
      {
        t: 'Three security modes',
        b: 'Biometric only, biometric plus password, or password only. The mode is recorded in the OS keyring and drives the login flow.',
        badge: 'MODES',
        code: '1. Touch ID Only — quick access, no password\n2. Touch ID + Master Password — two factors\n3. Master Password Only — universal',
      },
      {
        t: 'Biometric is an OS gate',
        b: 'Touch ID, Windows Hello or fprintd runs in front of a vault key that lives in the OS keyring. Your fingerprint authorises the unlock; it is not key material, and a process already running as you can read the key without presenting one. Use mode 2 if that matters to you.',
        badge: 'GATE',
        code: '# biometric.py — the check is a boolean, not a KDF input\nreturn result.returncode == 0',
      },
      {
        t: 'Adaptive lockout, per device',
        b: 'Three wrong passwords and the device is locked out for fifteen minutes. The counter is stored per machine and survives the process exiting.',
        badge: 'LOCKOUT',
        code: 'MAX_LOGIN_ATTEMPTS = 3\nLOCKOUT_DURATION   = 15 * 60\n\n⚠️ Invalid password. 1 attempt remaining.\n⛔ Login blocked. Try again in 15.0 minutes.',
      },
      {
        t: 'A recovery code, shown once',
        b: 'Biometric modes print a 24-character hex recovery code at setup. Only its hash is kept — a test asserts the plaintext is never persisted.',
        badge: 'RECOVERY',
        code: '⚠️  SAVE YOUR RECOVERY KEY — shown only once!',
      },
      {
        t: 'Sessions expire',
        b: 'Opening the airspace writes a session file with mode 0600 and a 30-minute clock. Closing it, locking with Ctrl+L, or letting it lapse all end access.',
        badge: 'SESSION',
        code: 'SESSION_TIMEOUT = 30 * 60\n$ irondome-cli status\n  Airspace: OPEN - 29 min remaining',
      },
    ],
  },
  {
    id: 'session',
    n: '03',
    tag: 'IN SESSION',
    title: 'While the vault is open',
    sub: 'The window where a secret is in the clear is the window that matters.',
    cards: [
      {
        t: 'Clipboard clears itself',
        b: 'Copying a password schedules its own erasure thirty seconds later, on every platform. A new copy cancels and replaces the pending timer.',
        badge: 'CLIPBOARD',
        code: 'def copy_with_auto_clear(secret: str,\n                         timeout: int = 30) -> bool:',
      },
      {
        t: 'Revealed passwords re-hide',
        b: 'Space reveals an entry; ten seconds later it masks itself again whether or not you looked away.',
        badge: 'REVEAL',
        code: '# detail screen — 10s auto-hide timer on reveal',
      },
      {
        t: 'Alternate screen buffer',
        b: 'The TUI runs in the alternate buffer, so nothing it drew is in your scrollback after you quit. Nothing to page back through, nothing in a terminal log.',
        badge: 'TTY',
        code: 'SMCUP on start / RMCUP on exit',
      },
      {
        t: 'Masked at the widget',
        b: 'Password inputs are masked by the widget itself, not by a redraw. There is no frame in which the characters are on screen.',
        badge: 'INPUT',
        code: 'Input(placeholder="Master password",\n      password=True, id="login-password")',
      },
      {
        t: 'Signals restore the terminal',
        b: 'SIGTERM, SIGINT and SIGHUP all run the same handler: put the terminal back, clear the clipboard, exit. A killed session does not leave a mess behind.',
        badge: 'SIGNALS',
        code: 'SIGTERM / SIGINT / SIGHUP\n  -> restore tty, clear clipboard, exit',
      },
      {
        t: 'Memory kept out of swap',
        b: 'The TUI asks the kernel to lock its pages resident so keys are not paged to disk. Best-effort and silently skipped if the OS refuses; the CLI does not attempt it at all.',
        badge: 'MEMORY',
        code: 'libc.mlockall(MCL_CURRENT | MCL_FUTURE)',
      },
    ],
  },
  {
    id: 'perimeter',
    n: '04',
    tag: 'AT THE PERIMETER',
    title: 'What can leave',
    sub: 'The strongest claim on this page, because it is the one that is mechanically enforced.',
    cards: [
      {
        t: 'No network calls anywhere in the package',
        b: 'Not "we do not sync" — there is no code path that could. No sockets are opened and no ports are bound by anything you install.',
        badge: 'NETWORK',
        code: '$ grep -rnE "(socket|http|urllib|requests|ssl)" \\\n      password_manager/\n(no matches)',
      },
      {
        t: 'Enforced by a test, not a promise',
        b: 'A suite walks the AST of every module and fails the build on a networking import, a resolver call, or an http:// literal. The allowlist is empty, and a separate test asserts it stays empty — so restoring network access means editing this claim in the same commit.',
        badge: 'CI',
        code: 'ALLOWLIST: frozenset = frozenset()\n\nassert ALLOWLIST == frozenset()\n# 106 tests, one per module per check',
      },
      {
        t: 'No account, no sync, no telemetry',
        b: 'There is nothing to sign up for, nothing to log in to, and no analytics. Installing does not create a relationship with anyone.',
        badge: 'NO ACCOUNT',
        code: '$ irondome-cli status\n  Dome:     configured\n  Airspace: CLOSED',
      },
      {
        t: 'Self-destruct that reports failure',
        b: 'nuke clears the three keyring entries, overwrites each file once with random bytes, fsyncs, and unlinks. Then it re-walks the directory: if anything survived, it returns success: False and names every leftover.',
        badge: 'ERASE',
        code: 'fh.write(os.urandom(size))\nfh.flush()\nos.fsync(fh.fileno())\n\n  [OK] 7 file(s) securely deleted.',
      },
      {
        t: `${counts.tests} tests gate the release`,
        b: 'Encryption round-trip and tamper detection, KDF parameters, keyring behaviour, file permissions, nuke completeness, and the network check. CI runs pytest and ruff before anything reaches PyPI.',
        badge: 'GATE',
        code: testBreakdown,
      },
      {
        t: 'GPL-3.0, all of it',
        b: 'Every line above is in the repository and every claim on this page can be checked against it. Derivatives stay open.',
        badge: 'LICENSE',
        code: 'GNU General Public License v3.0',
      },
    ],
  },
];

const rings = [
  { id: 'perimeter', r: 400, label: 'PERIMETER', note: 'no network path exists' },
  { id: 'door',      r: 310, label: 'THE DOOR',  note: 'PBKDF2 + lockout + session' },
  { id: 'session',   r: 220, label: 'IN SESSION',note: 'clipboard, tty, memory' },
  { id: 'rest',      r: 130, label: 'AT REST',   note: 'Fernet-encrypted vault' },
];

const shots = [
  ['01-splash',    'Splash',     'The animated dome banner on launch.'],
  ['02-login',     'Login',      'Password-only mode, masked at the widget.'],
  ['03-dashboard', 'Dashboard',  'Entry count, airspace state, session owner.'],
  ['04-vault',     'Vault',      'Searchable table with a strength column.'],
  ['05-detail',    'Entry',      'Space reveals, ten seconds hides it again.'],
  ['06-generator', 'Generator',  'Live preview and strength scoring.'],
  ['07-status',    'Status',     'Vault size, timeout, biometric availability.'],
  ['08-backup',    'Backup',     'Encrypted copies, written on demand.'],
  ['09-help',      'Help',       'Every binding, one keypress away.'],
];

const spec = [
  ['Symmetric encryption', 'AES-128-CBC (Fernet, with HMAC-SHA256)'],
  ['Key derivation',       'PBKDF2-HMAC-SHA256 × 600,000 (OWASP 2023)'],
  ['Password hashing',     'PBKDF2-HMAC-SHA256 + unique 16-byte salt'],
  ['Randomness',           "Python secrets — the OS CSPRNG"],
  ['IV',                   'Fresh 16 bytes per message'],
  ['Session file',         'Mode 0600, 30-minute timeout'],
  ['Failed logins',        '3 attempts, then 15-minute device lockout'],
  ['Clipboard',            'Auto-clear after 30 seconds'],
  ['Interface',            `Textual TUI (${counts.screens} screens) + CLI`],
  ['Platforms',            'macOS, Windows, Linux — Python 3.8–3.13'],
  ['Dependencies',         'cryptography, keyring, textual'],
  ['License',              'GPL-3.0-only'],
];

const limits = [
  ['Key protection is software-only', 'The vault key is protected by your password and by the OS keyring. There is no TPM and no Secure Enclave, and machine-id scoping is obfuscation rather than a hardware boundary.'],
  ['The biometric check is not cryptographic', 'It is an OS authentication gate in front of a keyring-stored key. A process already running as you can read that key without presenting a fingerprint.'],
  ['nuke cannot defeat an SSD controller', 'One overwrite pass, fsync, unlink. Wear-levelling, copy-on-write filesystems and journaling can all leave the original blocks. For guaranteed destruction, use full-disk encryption and destroy the key.'],
  ['The key is not zeroed in memory', 'It is held as immutable Python bytes inside a Fernet object and cannot be overwritten in place.'],
  ['No independent third-party audit', `${counts.tests} self-authored tests are not an audit. Nobody outside the project has reviewed the cryptography. Treat this as beta software.`],
];
---

<Layout title="IronDome">
  <span id="top"></span>

  <!-- ══════════════════════════════ HERO ══════════════════════════════ -->
  <section class="hero">
    <div class="hero-scope" aria-hidden="true">
      <img src={`${B}dome-mark.svg`} alt="" width="260" height="168" loading="eager" />
    </div>

    <div class="wrap hero-in">
      <p class="hero-eye mono">
        <span class="pip" aria-hidden="true"></span>
        Local-first password vault · v{counts.version}
      </p>

      <h1 class="hero-h1">
        <span class="ln">Your passwords stay on this machine —</span>
        <span class="ln ln-em">because nothing in the package can reach the network.</span>
      </h1>

      <p class="hero-lede">
        IronDome is a terminal vault. Entries are encrypted locally with
        <strong>AES-128-CBC via Fernet</strong>, keyed by
        <strong>PBKDF2-HMAC-SHA256 at 600,000 iterations</strong>. There is no account,
        no sync and no telemetry — and a test walks every module and fails the build
        if one of them so much as imports a networking library.
      </p>

      <div class="hero-cta">
        <div class="cmd bracket">
          <span class="sigil">$</span>
          <code id="hero-cmd">pip install IronDome</code>
          <button class="copy" type="button" data-copy="pip install IronDome">Copy</button>
        </div>
        <a class="btn" href="#tui">See a real session</a>
      </div>

      <ul class="hero-facts">
        {facts.map(([n, l], i) => (
          <li class="reveal" style={`--d:${240 + i * 70}ms`}>
            <span class="f-n mono">{n}</span>
            <span class="f-l mono">{l}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-fade" aria-hidden="true"></div>
  </section>

  <!-- ══════════════════════════════ TRUTHS ══════════════════════════════ -->
  <section class="sector" id="what">
    <span class="rail" aria-hidden="true"><span class="rail-tag">Sec 01 / Premise</span></span>
    <div class="sector-inner">
      <p class="eyebrow reveal">The premise</p>
      <h2 class="reveal">A password manager you can read end to end</h2>
      <p class="lede reveal" style="--d:80ms">
        Cloud vaults ask you to trust a company, its servers, its CDN and its staff.
        IronDome asks you to trust a Python package small enough to audit in an afternoon —
        and then it hands you the tests that check the parts you would have had to take on faith.
      </p>

      <div class="truths">
        {[
          ['Local-first, by construction', 'The vault is a file in your home directory. No service holds a copy, so no service can lose one.'],
          ['Nothing to sign up for', 'No account, no sync, no telemetry, no licence server. Installing it does not create a relationship with anyone.'],
          ['The source is the specification', 'GPL-3.0 on GitHub, published to PyPI from CI that runs the test suite and the linter first.'],
        ].map(([t, b], i) => (
          <article class="truth panel bracket reveal" style={`--d:${i * 110}ms`}>
            <h3>{t}</h3>
            <p>{b}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ HOW IT WORKS ══════════════════════════════ -->
  <section class="sector" id="how">
    <span class="rail" aria-hidden="true"><span class="rail-tag">Sec 02 / Sequence</span></span>
    <div class="sector-inner">
      <p class="eyebrow reveal">How it works</p>
      <h2 class="reveal">Three commands, in order, once.</h2>
      <p class="lede reveal" style="--d:80ms">
        This is a real sequence, so it is numbered. Everything after step three is you
        using it.
      </p>

      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal" style={`--d:${i * 130}ms`}>
            <span class="step-n mono">{String(i + 1).padStart(2, '0')}</span>
            <div class="step-body">
              <h3>{s.n}</h3>
              <p class="step-cmd mono"><span class="sigil">$</span> {s.cmd}</p>
              <p class="step-text">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══════════════════════════════ FOUR LAYERS ══════════════════════════════ -->
  <section class="sector" id="layers">
    <span class="rail" aria-hidden="true"><span class="rail-tag">Sec 03 / Layers</span></span>
    <div class="sector-inner">
      <p class="eyebrow reveal">The full feature set</p>
      <h2 class="reveal">Four layers, outside in</h2>
      <p class="lede reveal" style="--d:80ms">
        Every capability in IronDome sits at one of four distances from your secrets.
        Reading the layers from the outside in is also the order an attacker would meet them.
      </p>

      <div class="layers">
        {layers.map((L, li) => (
          <section class="layer" id={`layer-${L.id}`} data-layer={L.id}>
            <header class="layer-head reveal">
              <span class="layer-n mono">{L.n}</span>
              <div>
                <p class="layer-tag mono">{L.tag}</p>
                <h3 class="layer-title">{L.title}</h3>
                <p class="layer-sub">{L.sub}</p>
              </div>
            </header>
            <div class="cards">
              {L.cards.map((c, ci) => (
                <article class="card panel bracket reveal" style={`--d:${Math.min(ci, 3) * 80}ms`}>
                  <span class="badge badge--live">{c.badge}</span>
                  <h4 class="card-t">{c.t}</h4>
                  <p class="card-b">{c.b}</p>
                  <pre class="card-code mono"><code>{c.code}</code></pre>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ THE DOME ══════════════════════════════ -->
  <section class="sector sector--dome" id="dome">
    <span class="rail" aria-hidden="true"><span class="rail-tag">Sec 04 / Architecture</span></span>
    <div class="sector-inner">
      <p class="eyebrow reveal">The full security stack</p>
      <h2 class="reveal">One diagram, four rings, one file at the centre</h2>
      <p class="lede reveal" style="--d:80ms">
        The rings are the layers above, drawn to the scale of how far they sit from the
        encrypted file. Hover a ring to read what holds it.
      </p>

      <figure class="dome-fig reveal">
        <svg class="dome-svg" id="dome-svg" viewBox="0 0 900 540" role="img"
             aria-label="Concentric defence rings around the encrypted vault: perimeter, the door, in session, at rest.">
          <defs>
            <linearGradient id="gRing" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%"  stop-color="#c6dc68" stop-opacity=".95" />
              <stop offset="100%" stop-color="#9bae4a" stop-opacity=".18" />
            </linearGradient>
            <radialGradient id="gCore" cx="50%" cy="100%" r="90%">
              <stop offset="0%"  stop-color="#c6dc68" stop-opacity=".30" />
              <stop offset="100%" stop-color="#9bae4a" stop-opacity="0" />
            </radialGradient>
            <linearGradient id="gGround" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%"   stop-color="#2b383d" stop-opacity="0" />
              <stop offset="18%"  stop-color="#2b383d" stop-opacity="1" />
              <stop offset="82%"  stop-color="#2b383d" stop-opacity="1" />
              <stop offset="100%" stop-color="#2b383d" stop-opacity="0" />
            </linearGradient>
          </defs>

          <!-- ground glow under the vault -->
          <ellipse cx="450" cy="462" rx="250" ry="86" fill="url(#gCore)" class="d-glow" />

          <!-- sweep -->
          <g class="d-sweep">
            <path d="M450 462 L450 40 A422 422 0 0 1 690 110 Z" fill="url(#gCore)" opacity=".5" />
          </g>

          <!-- rings -->
          {rings.map((ring) => (
            <g class="d-ring" data-ring={ring.id}>
              <path
                class="d-arc"
                d={`M ${450 - ring.r} 462 A ${ring.r} ${ring.r} 0 0 1 ${450 + ring.r} 462`}
                fill="none"
                stroke="url(#gRing)"
                stroke-width="1.5"
                stroke-linecap="round"
              />
              <text class="d-label mono" x="450" y={462 - ring.r - 32} text-anchor="middle">{ring.label}</text>
              <text class="d-note mono" x="450" y={462 - ring.r - 16} text-anchor="middle">{ring.note}</text>
            </g>
          ))}

          <!-- incoming trace -->
          <g class="d-threat">
            <path class="d-trace" d="M 40 112 L 146 203" fill="none" stroke="#d0574a"
                  stroke-width="1.4" stroke-dasharray="5 5" />
            <circle class="d-blip" cx="40" cy="112" r="4" fill="#d0574a" />
            <g class="d-block" stroke="#d0574a" stroke-width="1.6">
              <line x1="139" y1="196" x2="153" y2="210" />
              <line x1="153" y1="196" x2="139" y2="210" />
            </g>
            <text class="d-threat-l mono" x="30" y="94" fill="#d0574a">INBOUND</text>
            <text class="d-threat-n mono" x="168" y="214" fill="#7c8c8e">no route in</text>
          </g>

          <!-- ground line -->
          <line x1="20" y1="462" x2="880" y2="462" stroke="url(#gGround)" stroke-width="1" />
          {Array.from({ length: 29 }).map((_, i) => (
            <line class="d-tick" x1={40 + i * 29} y1="462" x2={40 + i * 29} y2="470"
                  stroke="#2b383d" stroke-width="1" />
          ))}

          <!-- the vault -->
          <g class="d-core">
            <rect x="392" y="404" width="116" height="58" fill="#10171a" stroke="#c6dc68" stroke-width="1.2" />
            <text class="d-core-t mono" x="450" y="428" text-anchor="middle">.passwords</text>
            <text class="d-core-t mono" x="450" y="446" text-anchor="middle">.enc</text>
          </g>
        </svg>

        <figcaption class="dome-cap mono">
          Fig. 1 — Distance from the ciphertext, not depth of a hierarchy.
          A ring only holds if the ring outside it has already been crossed.
        </figcaption>
      </figure>

      <div class="dome-legend">
        {rings.slice().reverse().map((ring, i) => {
          const L = layers.find((x) => x.id === ring.id)!;
          return (
            <a class="leg panel bracket reveal" href={`#layer-${ring.id}`}
               data-ring-hover={ring.id} style={`--d:${i * 90}ms`}>
              <span class="leg-n mono">{L.n}</span>
              <span class="leg-t mono">{ring.label}</span>
              <span class="leg-b">{L.title}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ TUI ══════════════════════════════ -->
  <section class="sector" id="tui">
    <span class="rail" aria-hidden="true"><span class="rail-tag">Sec 05 / Recording</span></span>
    <div class="sector-inner">
      <p class="eyebrow reveal">The TUI, unfiltered</p>
      <h2 class="reveal">A whole session, start to self-destruct</h2>
      <p class="lede reveal" style="--d:80ms">
        Not a mock-up. IronDome 3.2.1 — the release this session was recorded against —
        was installed from PyPI into a throwaway home
        directory and driven through seven scenes — setup, unlock, four entries, search,
        backup, a lockout, and <span class="mono">nuke</span>. What replays below is that
        recording, verbatim, with only the temporary paths rewritten to
        <span class="mono">~</span>.
      </p>

      <div class="term reveal" id="term">
        <div class="term-chrome">
          <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="term-title mono">operator@localhost — irondome 3.2.1</span>
          <span class="term-rec mono"><span class="rec-dot" aria-hidden="true"></span>REC</span>
        </div>

        <div class="term-tabs" role="tablist" aria-label="Session scenes">
          {scenes.map((s, i) => (
            <button class="tab mono" type="button" role="tab" data-scene={i}
                    aria-selected={i === 0 ? 'true' : 'false'}>
              <span class="tab-n">{String(i + 1).padStart(2, '0')}</span>
              <span class="tab-l">{s.name}</span>
            </button>
          ))}
        </div>

        <div class="term-body">
          <pre class="term-out mono" id="term-out" aria-live="polite"></pre>
        </div>

        <div class="term-foot">
          <p class="term-cap" id="term-cap">{scenes[0].caption}</p>
          <div class="term-ctl">
            <button class="ctl mono" type="button" id="term-toggle" aria-label="Pause playback">Pause</button>
            <button class="ctl mono" type="button" id="term-restart">Restart scene</button>
          </div>
        </div>
      </div>

      <div class="shots">
        <p class="shots-head mono">Screens captured from the running app — Textual's own SVG export, not redrawn</p>
        <div class="shots-grid">
          {shots.map(([file, name, note], i) => (
            <figure class="shot reveal" style={`--d:${Math.min(i, 5) * 70}ms`}>
              <div class="shot-img">
                <img src={`${B}tui/${file}.svg`} alt={`IronDome TUI — ${name} screen`} loading="lazy" />
              </div>
              <figcaption>
                <span class="shot-n mono">{name}</span>
                <span class="shot-b">{note}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ SPEC ══════════════════════════════ -->
  <section class="sector" id="spec">
    <span class="rail" aria-hidden="true"><span class="rail-tag">Sec 06 / Spec</span></span>
    <div class="sector-inner">
      <p class="eyebrow reveal">Specification</p>
      <h2 class="reveal">The numbers, without adjectives</h2>
      <div class="spec reveal" style="--d:80ms">
        <dl>
          {spec.map(([k, v]) => (
            <div class="spec-row">
              <dt class="mono">{k}</dt>
              <dd class="mono">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ LIMITS ══════════════════════════════ -->
  <section class="sector sector--limits" id="limits">
    <span class="rail" aria-hidden="true"><span class="rail-tag">Sec 07 / Limits</span></span>
    <div class="sector-inner">
      <p class="eyebrow eyebrow--warn reveal">What IronDome does not do</p>
      <h2 class="reveal">The honest half of the page</h2>
      <p class="lede reveal" style="--d:80ms">
        Every item here is also in the README. If a security tool only tells you what it
        is good at, you are reading marketing.
      </p>
      <ul class="limits">
        {limits.map(([t, b], i) => (
          <li class="limit reveal" style={`--d:${i * 70}ms`}>
            <span class="badge badge--warn">Limit</span>
            <div>
              <h3>{t}</h3>
              <p>{b}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════ INSTALL / CTA ══════════════════════════════ -->
  <section class="sector cta" id="install">
    <div class="sector-inner cta-in">
      <p class="eyebrow reveal">Install</p>
      <h2 class="cta-h2 reveal">Two commands and you are in.</h2>
      <p class="lede reveal" style="--d:70ms">
        Python 3.8 to 3.13, on macOS, Windows and Linux. Nothing to configure, nothing to
        register, and <span class="mono">irondome nuke</span> undoes all of it.
      </p>

      <div class="install panel bracket reveal" style="--d:140ms">
        <div class="install-row">
          <span class="install-k mono">Install</span>
          <div class="cmd">
            <span class="sigil">$</span>
            <code>pip install IronDome</code>
            <button class="copy" type="button" data-copy="pip install IronDome">Copy</button>
          </div>
        </div>
        <div class="install-row">
          <span class="install-k mono">First run</span>
          <div class="cmd">
            <span class="sigil">$</span>
            <code>irondome-cli create bunker</code>
            <button class="copy" type="button" data-copy="irondome-cli create bunker">Copy</button>
          </div>
        </div>
        <div class="install-row">
          <span class="install-k mono">Every day</span>
          <div class="cmd">
            <span class="sigil">$</span>
            <code>irondome</code>
            <button class="copy" type="button" data-copy="irondome">Copy</button>
          </div>
        </div>

        <div class="install-foot">
          <a class="btn btn--primary" href="https://pypi.org/project/IronDome/" rel="noopener">
            View on PyPI <span aria-hidden="true">↗</span>
          </a>
          <a class="btn" href="https://github.com/TheKingHippopotamus/IronDome-Bunker" rel="noopener">
            Read the source <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
