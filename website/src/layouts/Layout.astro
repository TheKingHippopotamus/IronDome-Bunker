---
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'IronDome is a local-first password vault that lives in your terminal. AES-128-CBC via Fernet, PBKDF2-HMAC-SHA256 at 600,000 iterations, and no network calls anywhere in the package.',
} = Astro.props;

const B = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const site = 'https://thekinghippopotamus.github.io/IronDome-Bunker/';
const fullTitle = title === 'IronDome' ? 'IronDome — local-first password vault for the terminal' : `${title} — IronDome`;

const nav = [
  ['#layers', 'Layers'],
  ['#dome', 'Architecture'],
  ['#tui', 'Terminal'],
  ['#spec', 'Spec'],
  ['#limits', 'Limits'],
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090a" />
    <meta name="color-scheme" content="dark" />
    <meta name="keywords" content="password manager, terminal, TUI, local-first, Fernet, AES-128-CBC, PBKDF2, open source, Python" />
    <link rel="canonical" href={site} />

    <link rel="icon" type="image/svg+xml" href={`${B}favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${B}favicon.ico`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${B}apple-touch-icon.png`} />
    <link rel="manifest" href={`${B}site.webmanifest`} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}dome-mark.svg`} />
    <meta property="og:site_name" content="IronDome" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'IronDome',
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'macOS, Windows, Linux',
      softwareVersion: '3.2.1',
      license: 'https://www.gnu.org/licenses/gpl-3.0.html',
      description: description,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })} />
  </head>

  <body>
    <div class="atmos" aria-hidden="true"></div>

    <a class="skip" href="#main">Skip to content</a>

    <header class="hdr" id="hdr">
      <div class="hdr-in">
        <a class="mark" href="#top">
          <span class="mark-dot" aria-hidden="true"></span>
          <span class="mark-name">IronDome</span>
          <span class="mark-ver">3.2.1</span>
        </a>
        <nav class="nav" aria-label="Sections">
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <a class="hdr-cta" href="https://github.com/TheKingHippopotamus/IronDome-Bunker" rel="noopener">
          Source
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="hdr-scan" aria-hidden="true"></div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="ftr">
      <div class="wrap ftr-in">
        <div class="ftr-col">
          <p class="ftr-title mono">IronDome 3.2.1</p>
          <p class="ftr-note">
            A local-first password vault for the terminal. Free software under the
            GNU General Public License v3.0 — the source is the specification.
          </p>
        </div>
        <div class="ftr-col ftr-links">
          <a href="https://pypi.org/project/IronDome/" rel="noopener">PyPI</a>
          <a href="https://github.com/TheKingHippopotamus/IronDome-Bunker" rel="noopener">GitHub</a>
          <a href="https://github.com/TheKingHippopotamus/IronDome-Bunker/blob/main/README.md" rel="noopener">README</a>
          <a href="https://github.com/TheKingHippopotamus/IronDome-Bunker/blob/main/SECURITY.md" rel="noopener">Report a vulnerability</a>
          <a href="https://github.com/TheKingHippopotamus/IronDome-Bunker/blob/main/LICENSE" rel="noopener">License</a>
        </div>
      </div>
      <div class="wrap ftr-base mono">
        <span>Beta software. No independent third-party audit.</span>
        <span>GPL-3.0</span>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--dome);
        color: #0a0d06;
        padding: 10px 16px;
        font-family: var(--mono);
        font-size: 13px;
      }
      .skip:focus { left: 12px; top: 12px; }

      /* ---------------- header ---------------- */
      .hdr {
        position: sticky;
        top: 0;
        z-index: 40;
        background: color-mix(in srgb, var(--void) 82%, transparent);
        backdrop-filter: blur(14px) saturate(1.3);
        -webkit-backdrop-filter: blur(14px) saturate(1.3);
        border-bottom: 1px solid var(--rule);
      }
      .hdr-in {
        max-width: var(--maxw);
        margin-inline: auto;
        padding: 0 var(--gut);
        height: 62px;
        display: flex;
        align-items: center;
        gap: 26px;
      }
      .hdr-scan {
        height: 1px;
        background: linear-gradient(to right, transparent, var(--dome), transparent);
        opacity: .34;
        transform-origin: left;
        animation: sweep 9s var(--ease) infinite;
      }
      @keyframes sweep {
        0%   { transform: translateX(-100%) scaleX(.35); opacity: 0; }
        18%  { opacity: .5; }
        100% { transform: translateX(100%) scaleX(.35); opacity: 0; }
      }

      .mark {
        display: flex;
        align-items: baseline;
        gap: 9px;
        text-decoration: none;
        font-family: var(--mono);
      }
      .mark-dot {
        width: 7px; height: 7px;
        background: var(--dome);
        border-radius: 50%;
        align-self: center;
        box-shadow: 0 0 0 0 rgba(155, 174, 74, .55);
        animation: ping 3.4s var(--ease) infinite;
      }
      @keyframes ping {
        0%   { box-shadow: 0 0 0 0 rgba(155, 174, 74, .5); }
        70%  { box-shadow: 0 0 0 9px rgba(155, 174, 74, 0); }
        100% { box-shadow: 0 0 0 0 rgba(155, 174, 74, 0); }
      }
      .mark-name { font-size: 15px; font-weight: 700; letter-spacing: -.02em; }
      .mark-ver { font-size: 10px; letter-spacing: .18em; color: var(--fg-4); }

      .nav {
        display: none;
        gap: 24px;
        margin-left: auto;
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: .1em;
        text-transform: uppercase;
      }
      .nav a {
        color: var(--fg-3);
        text-decoration: none;
        padding-block: 6px;
        border-bottom: 1px solid transparent;
        transition: color .22s, border-color .22s;
      }
      .nav a:hover { color: var(--fg); border-bottom-color: var(--dome); }

      .hdr-cta {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: .08em;
        text-decoration: none;
        color: var(--fg-2);
        border: 1px solid var(--rule-hi);
        padding: 7px 13px;
        transition: color .22s, border-color .22s;
      }
      .hdr-cta:hover { color: var(--dome-hi); border-color: var(--dome-dim); }

      @media (min-width: 900px) {
        .nav { display: flex; }
        .hdr-cta { margin-left: 0; }
      }

      /* ---------------- footer ---------------- */
      .ftr {
        position: relative;
        z-index: 1;
        border-top: 1px solid var(--rule);
        background: var(--steel);
        padding-top: 56px;
      }
      .ftr-in {
        display: grid;
        gap: 34px;
        padding-bottom: 40px;
      }
      .ftr-title { font-size: 14px; letter-spacing: .16em; text-transform: uppercase; margin: 0 0 10px; color: var(--fg); }
      .ftr-note { margin: 0; color: var(--fg-3); font-size: 14px; max-width: 48ch; }
      .ftr-links { display: flex; flex-wrap: wrap; gap: 10px 26px; align-content: start; }
      .ftr-links a {
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: .08em;
        color: var(--fg-2);
        text-decoration: none;
        border-bottom: 1px solid var(--rule-hi);
        padding-bottom: 2px;
        transition: color .2s, border-color .2s;
      }
      .ftr-links a:hover { color: var(--dome-hi); border-color: var(--dome); }
      .ftr-base {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        border-top: 1px solid var(--rule);
        padding-block: 18px;
        font-size: 11px;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--fg-4);
      }
      @media (min-width: 820px) {
        .ftr-in { grid-template-columns: 1fr 1fr; gap: 60px; }
      }
    </style>
  </body>
</html>
